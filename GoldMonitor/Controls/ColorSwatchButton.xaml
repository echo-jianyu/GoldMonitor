<UserControl x:Class="GoldMonitor.Controls.ColorSwatchButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             VerticalAlignment="Center" HorizontalAlignment="Left"
             d:DesignHeight="34" d:DesignWidth="34">

    <Grid>
        <!-- 色块按钮：点击弹出调色板 -->
        <Button x:Name="SwatchButton" Click="SwatchButton_Click" Focusable="False" Cursor="Hand">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="White" BorderBrush="#D1D1D6" BorderThickness="1"
                            CornerRadius="7" Padding="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#007AFF"/>
                            <Setter TargetName="Bd" Property="Background" Value="#F7F9FC"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <Border x:Name="Fill" Width="20" Height="20" CornerRadius="4"/>
        </Button>

        <!-- 调色板弹窗：预设颜色 + 自定义 HEX -->
        <Popup x:Name="PalettePopup" PlacementTarget="{Binding ElementName=SwatchButton}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="White" CornerRadius="10" BorderBrush="#E5E5EA" BorderThickness="1"
                    Padding="12" Margin="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.22"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="选择颜色" FontSize="11" Foreground="#8E8E93" Margin="0,0,0,8"/>
                    <UniformGrid x:Name="PaletteGrid" Columns="9"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="自定义:" FontSize="12" Foreground="#636366"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="HexInput" Grid.Column="1" Width="96" Height="26"
                                 VerticalContentAlignment="Center" Padding="6,0"
                                 KeyDown="HexInput_KeyDown" LostFocus="HexInput_LostFocus"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
