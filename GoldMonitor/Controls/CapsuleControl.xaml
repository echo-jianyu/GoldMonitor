<UserControl x:Class="GoldMonitor.Controls.CapsuleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="RootCapsule">

    <Border x:Name="OuterBorder"
            CornerRadius="16"
            Padding="12,5"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

        <!-- 布局矢量等比缩放 -->
        <Border.LayoutTransform>
            <ScaleTransform x:Name="CapsuleScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
        </Border.LayoutTransform>
        
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- 国际金价 (XAU) 模块 -->
            <StackPanel x:Name="XauPanel" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 标签 -->
                <TextBlock x:Name="TxtXauLabel"
                           FontSize="10" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center" 
                           Margin="0,0,4,0"/>

                <!-- 现价 -->
                <TextBlock x:Name="TxtXauPrice"
                           FontSize="12" 
                           FontWeight="SemiBold" 
                           VerticalAlignment="Center"/>

                <!-- 涨跌幅 -->
                <TextBlock x:Name="TxtXauRate"
                           FontSize="10" 
                           Margin="3,0,0,0" 
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 中间分割微线 -->
            <Rectangle x:Name="DividerRect" 
                       Width="1" 
                       Height="12" 
                       Fill="#3A3A3C" 
                       Margin="6,0,6,0" 
                       VerticalAlignment="Center"/>

            <!-- 国内金价 (AU9999) 模块 -->
            <StackPanel x:Name="DomPanel" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 标签 -->
                <TextBlock x:Name="TxtDomLabel"
                           FontSize="10" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center" 
                           Margin="0,0,4,0"/>

                <!-- 现价 -->
                <TextBlock x:Name="TxtDomPrice"
                           FontSize="12" 
                           FontWeight="SemiBold" 
                           VerticalAlignment="Center"/>

                <!-- 涨跌幅 -->
                <TextBlock x:Name="TxtDomRate"
                           FontSize="10" 
                           Margin="3,0,0,0" 
                           VerticalAlignment="Center"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>