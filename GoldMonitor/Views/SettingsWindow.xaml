<Window x:Class="GoldMonitor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GoldMonitor.Controls"
        xmlns:converters="clr-namespace:GoldMonitor.Converters"
        xmlns:vm="clr-namespace:GoldMonitor.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="金价胶囊 - 设置"
        Icon="/Assets/App.ico"
        Height="700" Width="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F7"
        Foreground="#1D1D1F"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">

    <Window.Resources>
        <!-- 0. 百分比互转：Slider + TextBox 组合输入用 -->
        <converters:PercentConverter x:Key="PercentConverter"/>

        <!-- 1. 卡片容器 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#E8E8ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1D1D1F"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#8E8E93"/>
        </Style>

        <!-- 2. 扁平按钮（普通 + 强调色） -->
        <ControlTemplate x:Key="FlatButtonTemplate" TargetType="Button">
            <Border x:Name="Bd" CornerRadius="7"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="Flat" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1D1D1F"/>
            <Setter Property="BorderBrush" Value="#D1D1D6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F7F7F9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#EBEBEF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Accent" TargetType="Button" BasedOn="{StaticResource Flat}">
            <Setter Property="Background" Value="#007AFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="22,6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2B8CFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0069D9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 3. 现代扁平复选框 -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#1D1D1F"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="4"
                                    Background="White" BorderBrush="#C7C7CC" BorderThickness="1.5"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check" Data="M3,8.5 L7,12.5 L13,3" Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#007AFF"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#007AFF"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#007AFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 4. 输入控件 -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderBrush" Value="#D1D1D6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. 顶部实时预览带 -->
            <RowDefinition Height="Auto"/>
            <!-- 2. 中部：侧边导航 + 设置内容 -->
            <RowDefinition Height="*"/>
            <!-- 3. 底部操作栏 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 1. 实时预览带 ==================== -->
        <Border Grid.Row="0" Background="#4C4C4E" Padding="12,9,12,11">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="实时样式预览" Foreground="#8E8E93" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,0,0,7"/>
                <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid HorizontalAlignment="Left" Margin="0,0,0,8"
                          MinWidth="{Binding ViewportWidth, ElementName=PreviewScroll}">
                        <controls:CapsuleControl PriceInfo="{Binding PreviewPrice}"
                                                 Settings="{Binding Settings}" HorizontalAlignment="Center"/>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ==================== 2. 侧边导航 + 设置内容 ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航栏 -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E5E5EA" BorderThickness="0,0,1,0">
                <ListBox x:Name="NavList" SelectedIndex="0" Margin="10,14,10,10"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" CornerRadius="8" Padding="10,9"
                                                Margin="0,0,0,2" Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#F2F2F7"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#E8F1FF"/>
                                                <Setter Property="Foreground" Value="#007AFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Text="常规与外观" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Text="模块显示" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Text="涨跌配色" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Text="关于" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Border>

            <!-- 右侧内容区：四个页面按导航切换 -->
            <Grid Grid.Column="1" Margin="18,14,18,16" VerticalAlignment="Stretch">

                <!-- ============ 页面 1: 常规与外观 ============ -->
                <ScrollViewer x:Name="PageGeneral" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,4,0">

                        <!-- 运行 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="运行" Style="{StaticResource CardTitle}"/>
                                <CheckBox Content="开机时自动启动" IsChecked="{Binding Settings.AutoStart}"/>
                                <CheckBox Content="全屏应用 / 游戏 / 视频时自动隐藏 (免打扰)" IsChecked="{Binding Settings.AutoHideOnFullScreen}" Margin="0,10,0,0"/>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="75"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="数据刷新间隔:" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="1" Maximum="300" SmallChange="1" LargeChange="5"
                                            Value="{Binding Settings.RefreshIntervalSeconds}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBox Width="50" TextAlignment="Center"
                                            Text="{Binding Settings.RefreshIntervalSeconds,UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Text="秒" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#636366"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 透明度 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="透明度" Style="{StaticResource CardTitle}"/>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="75"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="平时静默透明度:" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="0" Grid.Column="1" Minimum="0.05" Maximum="1.0"
                                            SmallChange="0.01" LargeChange="0.10"
                                            TickFrequency="0.01" IsSnapToTickEnabled="True"
                                            Value="{Binding Settings.IdleOpacity}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBox Width="50" TextAlignment="Center"
                                                 Text="{Binding Settings.IdleOpacity, Converter={StaticResource PercentConverter}, ConverterParameter=int, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#636366"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="鼠标移入透明度:" VerticalAlignment="Center" Margin="0,14,0,0"/>
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="0.05" Maximum="1.0"
                                            SmallChange="0.01" LargeChange="0.10"
                                            TickFrequency="0.01" IsSnapToTickEnabled="True"
                                            Value="{Binding Settings.HoverOpacity}" VerticalAlignment="Center" Margin="0,14,0,0"/>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,14,0,0">
                                        <TextBox Width="50" TextAlignment="Center"
                                                 Text="{Binding Settings.HoverOpacity, Converter={StaticResource PercentConverter}, ConverterParameter=int, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#636366"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 界面缩放 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="界面缩放" Style="{StaticResource CardTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="缩放比例:" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0.5" Maximum="3.0"
                                            SmallChange="0.05" LargeChange="0.1"
                                            TickFrequency="0.05" IsSnapToTickEnabled="True"
                                            Value="{Binding Settings.UiScale}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBox Width="40" TextAlignment="Center"
                                                 Text="{Binding Settings.UiScale, Converter={StaticResource PercentConverter}, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#636366"/>
                                    </StackPanel>
                                </Grid>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content=" 80%  迷你" Command="{Binding SetScaleCommand}" CommandParameter="0.8"
                                            Style="{StaticResource Flat}" Padding="10,5" Margin="0,0,8,4"/>
                                    <Button Content="100% 标准" Command="{Binding SetScaleCommand}" CommandParameter="1.0"
                                            Style="{StaticResource Flat}" Padding="10,5" Margin="0,0,8,4"/>
                                    <Button Content="125% 清晰" Command="{Binding SetScaleCommand}" CommandParameter="1.25"
                                            Style="{StaticResource Flat}" Padding="10,5" Margin="0,0,8,4"/>
                                    <Button Content="150% 大号" Command="{Binding SetScaleCommand}" CommandParameter="1.5"
                                            Style="{StaticResource Flat}" Padding="10,5" Margin="0,0,8,4"/>
                                    <Button Content="180% 巨型" Command="{Binding SetScaleCommand}" CommandParameter="1.8"
                                            Style="{StaticResource Flat}" Padding="10,5" Margin="0,0,8,4"/>
                                    <Button Content="250% 超大" Command="{Binding SetScaleCommand}" CommandParameter="2.5"
                                            Style="{StaticResource Flat}" Padding="10,5" Margin="0,0,8,4"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- 字体与胶囊配色 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="字体与胶囊配色" Style="{StaticResource CardTitle}"/>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="全局字体:" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding SystemFonts}"
                                              SelectedItem="{Binding Settings.FontFamily}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="胶囊背景色:" VerticalAlignment="Center" Margin="0,14,0,0"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,14,0,0">
                                        <controls:ColorSwatchButton ColorHex="{Binding Settings.CapsuleBackground}"/>
                                        <TextBlock Text="{Binding Settings.CapsuleBackground}" Style="{StaticResource Hint}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="胶囊边框色:" VerticalAlignment="Center" Margin="0,12,0,0"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                                        <controls:ColorSwatchButton ColorHex="{Binding Settings.CapsuleBorderColor}"/>
                                        <TextBlock Text="{Binding Settings.CapsuleBorderColor}" Style="{StaticResource Hint}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ 页面 2: 模块显示 ============ -->
                <ScrollViewer x:Name="PageModules" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,4,0">

                        <!-- 统一显示规则 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="显示规则" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="以下开关会同步应用到全部 5 个模块，无需逐个配置" Style="{StaticResource Hint}"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <CheckBox Content="标签" IsChecked="{Binding UnifiedShowLabel}" Margin="0,0,18,10"/>
                                    <CheckBox Content="价格" IsChecked="{Binding UnifiedShowPrice}" Margin="0,0,18,10"/>
                                    <CheckBox Content="涨跌幅" IsChecked="{Binding UnifiedShowRate}" Margin="0,0,18,10"/>
                                    <CheckBox Content="正负号 (+/-)" IsChecked="{Binding UnifiedSign}" Margin="0,0,18,10"/>
                                    <CheckBox Content="百分号 (%)" IsChecked="{Binding UnifiedPercent}" Margin="0,0,18,10"/>
                                    <CheckBox Content="分割线" IsChecked="{Binding Settings.ShowDividers}" Margin="0,0,0,10"/>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="价格小数位数:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox SelectedIndex="{Binding UnifiedDecimals}" Width="150" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="0 位 · 取整"/>
                                        <ComboBoxItem Content="1 位 · 紧凑"/>
                                        <ComboBoxItem Content="2 位 · 标准行情"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 模块个性化列表 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="模块个性化" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="启用 / 停用模块，或单独调整各模块的标签文字与颜色" Style="{StaticResource Hint}"/>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto" MinHeight="46"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto" MinHeight="46"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto" MinHeight="46"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto" MinHeight="46"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto" MinHeight="46"/>
                                    </Grid.RowDefinitions>

                                    <!-- 表头 -->
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="模块" Style="{StaticResource ColHeader}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="标签文字" Style="{StaticResource ColHeader}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="标签色" Style="{StaticResource ColHeader}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Row="0" Grid.Column="4" Text="价格色" Style="{StaticResource ColHeader}" HorizontalAlignment="Center"/>

                                    <!-- 国际金价 XAU -->
                                    <CheckBox Grid.Row="1" Grid.Column="0" IsChecked="{Binding Settings.ShowXau}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="国际金价 (XAU)" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Settings.XauLabelText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <controls:ColorSwatchButton Grid.Row="1" Grid.Column="3" HorizontalAlignment="Center"
                                                                ColorHex="{Binding Settings.XauLabelColor}"/>
                                    <controls:ColorSwatchButton Grid.Row="1" Grid.Column="4" HorizontalAlignment="Center"
                                                                ColorHex="{Binding Settings.XauPriceColor}"/>

                                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Background="#F2F2F5" Height="1"/>

                                    <!-- 国内金价 AU9999 -->
                                    <CheckBox Grid.Row="3" Grid.Column="0" IsChecked="{Binding Settings.ShowDom}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="国内金价 (AU9999)" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding Settings.DomLabelText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <controls:ColorSwatchButton Grid.Row="3" Grid.Column="3" HorizontalAlignment="Center"
                                                                ColorHex="{Binding Settings.DomLabelColor}"/>
                                    <controls:ColorSwatchButton Grid.Row="3" Grid.Column="4" HorizontalAlignment="Center"
                                                                ColorHex="{Binding Settings.DomPriceColor}"/>

                                    <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" Background="#F2F2F5" Height="1"/>

                                    <!-- 黄金延期 Au(T+D) -->
                                    <CheckBox Grid.Row="5" Grid.Column="0" IsChecked="{Binding Settings.ShowAutd}"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="黄金延期 (AuTD)" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding Settings.AutdLabelText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <controls:ColorSwatchButton Grid.Row="5" Grid.Column="3" HorizontalAlignment="Center"
                                                                ColorHex="{Binding Settings.AutdLabelColor}"/>
                                    <controls:ColorSwatchButton Grid.Row="5" Grid.Column="4" HorizontalAlignment="Center"
                                                                ColorHex="{Binding Settings.AutdPriceColor}"/>

                                    <Border Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="5" Background="#F2F2F5" Height="1"/>

                                    <!-- 民生积存金 -->
                                    <CheckBox Grid.Row="7" Grid.Column="0" IsChecked="{Binding Settings.ShowMs}"/>
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="民生积存金 (京东金融)" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="7" Grid.Column="2" Text="{Binding Settings.MsLabelText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <controls:ColorSwatchButton Grid.Row="7" Grid.Column="3" HorizontalAlignment="Center"
                                                                ColorHex="{Binding Settings.MsLabelColor}"/>
                                    <controls:ColorSwatchButton Grid.Row="7" Grid.Column="4" HorizontalAlignment="Center"
                                                                ColorHex="{Binding Settings.MsPriceColor}"/>

                                    <Border Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="5" Background="#F2F2F5" Height="1"/>

                                    <!-- 浙商积存金 -->
                                    <CheckBox Grid.Row="9" Grid.Column="0" IsChecked="{Binding Settings.ShowZs}"/>
                                    <TextBlock Grid.Row="9" Grid.Column="1" Text="浙商积存金 (京东金融)" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="9" Grid.Column="2" Text="{Binding Settings.ZsLabelText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <controls:ColorSwatchButton Grid.Row="9" Grid.Column="3" HorizontalAlignment="Center"
                                                                ColorHex="{Binding Settings.ZsLabelColor}"/>
                                    <controls:ColorSwatchButton Grid.Row="9" Grid.Column="4" HorizontalAlignment="Center"
                                                                ColorHex="{Binding Settings.ZsPriceColor}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 数据源说明 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="数据源说明" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource Hint}">
                                    <Run Text="· 新浪财经：伦敦金 XAU / 上金所 Au9999 / 黄金延期 Au(T+D)"/>
                                    <LineBreak/>
                                    <Run Text="· 京东金融：民生 / 浙商积存金（数据获取失败时价格显示 0.00）"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ 页面 3: 涨跌配色 ============ -->
                <ScrollViewer x:Name="PageColors" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,4,0">

                        <!-- 一键配色方案 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="一键配色方案" Style="{StaticResource CardTitle}"/>
                                <WrapPanel>
                                    <Button Command="{Binding ApplyColorPresetCommand}" CommandParameter="GoldGreen"
                                            Style="{StaticResource Flat}" Padding="14,7" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="10" Height="10" Fill="#C07D00"/>
                                            <Ellipse Width="10" Height="10" Fill="#4EAF50" Margin="5,0,0,0"/>
                                            <TextBlock Text="柔金 / 翡翠" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ApplyColorPresetCommand}" CommandParameter="RedGreen"
                                            Style="{StaticResource Flat}" Padding="14,7" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="10" Height="10" Fill="#E53935"/>
                                            <Ellipse Width="10" Height="10" Fill="#43A047" Margin="5,0,0,0"/>
                                            <TextBlock Text="国内红涨 / 绿跌" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ApplyColorPresetCommand}" CommandParameter="GreenRed"
                                            Style="{StaticResource Flat}" Padding="14,7">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="10" Height="10" Fill="#43A047"/>
                                            <Ellipse Width="10" Height="10" Fill="#E53935" Margin="5,0,0,0"/>
                                            <TextBlock Text="国际绿涨 / 红跌" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- 自定义涨跌颜色 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="自定义涨跌颜色" Style="{StaticResource CardTitle}"/>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="上涨颜色:" VerticalAlignment="Center"/>
                                    <controls:ColorSwatchButton Grid.Row="0" Grid.Column="1" ColorHex="{Binding Settings.UpColor}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Settings.UpColor}" Style="{StaticResource Hint}"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="下跌颜色:" VerticalAlignment="Center" Margin="0,14,0,0"/>
                                    <controls:ColorSwatchButton Grid.Row="1" Grid.Column="1" ColorHex="{Binding Settings.DownColor}" Margin="0,14,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Settings.DownColor}" Style="{StaticResource Hint}"
                                               VerticalAlignment="Center" Margin="10,14,0,0"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="平盘颜色:" VerticalAlignment="Center" Margin="0,14,0,0"/>
                                    <controls:ColorSwatchButton Grid.Row="2" Grid.Column="1" ColorHex="{Binding Settings.FlatColor}" Margin="0,14,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Settings.FlatColor}" Style="{StaticResource Hint}"
                                               VerticalAlignment="Center" Margin="10,14,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ 页面 4: 关于 ============ -->
                <ScrollViewer x:Name="PageAbout" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,4,0">

                        <!-- 软件头部卡片 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel HorizontalAlignment="Center" Margin="0,4,0,4">
                                <Image Source="/Assets/App.ico" Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="金价胶囊" FontSize="18" FontWeight="Bold" Foreground="#1D1D1F"/>
                                    <Border Background="#E5E5EA" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AppVersion}" FontSize="11" FontWeight="SemiBold" Foreground="#636366"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="极简、优雅、低占用的 Windows 桌面实时金价悬浮胶囊"
                                           Foreground="#8E8E93" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 开源与主页 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="开源与主页" Style="{StaticResource CardTitle}"/>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="开源协议:" Foreground="#8E8E93" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="MIT License" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="GitHub 主页:" Foreground="#8E8E93" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center">
                                        <Hyperlink NavigateUri="https://github.com/echo-jianyu/GoldMonitor" RequestNavigate="Hyperlink_RequestNavigate">
                                            GitHub 仓库主页 (欢迎 Star)
                                        </Hyperlink>
                                    </TextBlock>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="问题反馈:" Foreground="#8E8E93" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center">
                                        <Hyperlink NavigateUri="https://github.com/echo-jianyu/GoldMonitor/issues" RequestNavigate="Hyperlink_RequestNavigate">
                                            提交 Bug 或建议 (Issues)
                                        </Hyperlink>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 技术说明与声明 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="技术说明与声明" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="· 目标运行时：.NET Framework 4.8" Foreground="#3A3A3C" Margin="0,3"/>
                                <TextBlock Text="· 界面框架：WPF + CommunityToolkit.Mvvm" Foreground="#3A3A3C" Margin="0,3"/>
                                <TextBlock Text="· 行情数据源：新浪财经 + 京东金融（民生 / 浙商积存金）" Foreground="#3A3A3C" Margin="0,3"/>
                                <Separator Background="#EAEAEA" Margin="0,10"/>
                                <TextBlock Text="免责声明: 本软件行情数据仅供个人参考展示，不构成任何投资或交易建议。"
                                           Foreground="#8E8E93" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ==================== 3. 底部操作栏 ==================== -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E5EA" BorderThickness="0,1,0,0" Padding="16,11">
            <Grid>
                <Button Content="恢复默认" Command="{Binding ResetToDefaultsCommand}"
                        Style="{StaticResource Flat}" HorizontalAlignment="Left" Padding="14,6"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="确定" Command="{Binding SaveCommand}" Style="{StaticResource Accent}"
                            IsDefault="True" Margin="0,0,10,0"/>
                    <Button Content="取消" Command="{Binding CancelCommand}"
                            Style="{StaticResource Flat}" IsCancel="True" Padding="16,6"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
